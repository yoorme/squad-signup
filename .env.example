# 复制为 .env 并填入真实值
# Vercel / Zeabur 部署时这些变量在控制台 → Settings → Environment Variables 配置

# 数据库（PostgreSQL）
# 生产环境需配两个连接串：
#   DATABASE_URL = pooled 连接串（-pooler 后缀，带 ?pgbouncer=true&sslmode=require）→ 应用运行时用
#   DIRECT_URL   = 直连串（不带 -pooler，带 ?sslmode=require）→ Prisma 迁移用
# Zeabur 部署时：创建 PostgreSQL 服务后，连接串会自动注入到 DATABASE_URL
# 若 Zeabur 未自动注入 DIRECT_URL，请手动添加（与 DATABASE_URL 相同即可）
# 本地开发两者填同一个本地连接串即可
DATABASE_URL="postgresql://user:password@localhost:5432/squad_signup?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/squad_signup?schema=public"

# NextAuth 密钥（生产必须改成强随机串）
# 生成：openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string-change-in-production"

# 初始管理员（首次 seed 时创建，之后可改密码）
INITIAL_ADMIN_USERNAME="MMR丨Admin"
INITIAL_ADMIN_PASSWORD="admin123456"

# 站点 URL（生产 = 部署平台分配的域名，如 https://xxx.zeabur.app）
NEXTAUTH_URL="http://localhost:3000"

# 信任 Host（用 IP 访问必须为 true；用 HTTPS 域名可设为 false）
# NextAuth v5 默认不信任非标准 host，自托管/IP/反向代理场景都建议 true
AUTH_TRUST_HOST="true"
